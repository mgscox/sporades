{
  "uid": "sporades-resources",
  "title": "Sporades Capsule Resources",
  "description": "Process CPU, memory, GC and event-loop pressure alongside API latency for enabled Capsules. Rate and delay lookback follow the Metric window selector; each instance is a distinct process lifetime.",
  "schemaVersion": 41,
  "version": 5,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "sporades",
    "resources"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU cores used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,instance) (rate(process_cpu_time_seconds_total{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}[${metric_window}]))",
          "legendFormat": "{{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      },
      "description": "100% of one CPU core equals 1.0; a multi-core process can exceed 1.0. Rate handles process counter resets."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU time by state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_time_seconds_total{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "{{service_name}} {{instance}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "description": "Cumulative user and system CPU seconds since process start; resets on restart."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Resident memory (RSS)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_rss_bytes{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "{{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "description": "Resident process memory. Do not add it to heap or external memory."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JavaScript heap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_heap_used_bytes{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "used {{service_name}} {{instance}}"
        },
        {
          "refId": "B",
          "expr": "process_memory_heap_allocated_bytes{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "allocated {{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "description": "Heap used and allocated bytes. The V8 limit is shown separately and is not a container/RSS cap."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "External memory and ArrayBuffers",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_external_bytes{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "external {{service_name}} {{instance}}"
        },
        {
          "refId": "B",
          "expr": "process_memory_array_buffers_bytes{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "ArrayBuffers {{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "description": "ArrayBuffers, including Buffers, are already included in external memory. These lines are not additive."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Process uptime",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_uptime_seconds{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "{{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "description": "Seconds since process start; resets to zero on restart."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "V8 heap limit",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "C",
          "expr": "process_memory_heap_limit_bytes{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "V8 limit {{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "description": "Maximum V8 heap size. This is not a container or RSS memory limit."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GC collections per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,instance,kind) (rate(process_gc_count_total{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}[${metric_window}]))",
          "legendFormat": "GC/s {{kind}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "description": "Reset-aware collection rate by bounded GC kind, per process instance."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GC pause time per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,instance,kind) (rate(process_gc_duration_seconds_total{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}[${metric_window}]))",
          "legendFormat": "{{kind}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "description": "Reset-aware GC pause seconds per elapsed second, by bounded GC kind."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Event-loop delay",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(process_event_loop_delay_max_milliseconds{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}[${metric_window}])",
          "legendFormat": "max {{instance}}"
        },
        {
          "refId": "B",
          "expr": "process_event_loop_delay_p99_milliseconds{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "p99 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        }
      },
      "description": "Timer delay in milliseconds. Max retains the largest export-window peak within the selected Metric window and includes a conservative lower bound for reset gaps; it can understate a missed stall. P99 uses only the latest native histogram sample. A permanently blocked loop cannot export."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Event-loop utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_event_loop_utilization_ratio{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`}",
          "legendFormat": "utilization {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        }
      },
      "description": "Fraction of wall time spent outside the event provider in the latest export interval. This is not CPU utilization."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "API request p95 latency",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service_name,instance) (rate(http_server_request_duration_seconds_bucket{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,instance=~`${instance:regex}`,sporades_http_outcome!=\"abort\"}[${metric_window}])))",
          "legendFormat": "p95 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "description": "Declared-route API request p95 from the same process instance, excluding aborted requests as in the API dashboard. Needs at least two exports in the selected Metric window; longer windows smooth brief latency changes."
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Capsule",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "query": "label_values(process_memory_rss_bytes, service_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "query": "label_values(process_memory_rss_bytes, deployment_environment_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Process instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "query": "label_values(process_memory_rss_bytes{service_name=~`${service:regex}`}, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "metric_window",
        "label": "Metric window",
        "type": "custom",
        "query": "2m,12m",
        "options": [
          {
            "selected": false,
            "text": "2m",
            "value": "2m"
          },
          {
            "selected": true,
            "text": "12m",
            "value": "12m"
          }
        ],
        "current": {
          "selected": true,
          "text": "12m",
          "value": "12m"
        },
        "multi": false,
        "includeAll": false,
        "description": "12m supports metric exports up to 300s; use 2m only with exports at most 30s apart. Longer windows smooth rates and retain older delay peaks."
      }
    ]
  }
}
