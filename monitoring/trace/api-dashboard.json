{
  "uid": "sporades-api",
  "title": "Sporades Capsule API",
  "description": "Independent request metrics for enabled Capsules. Rate and latency lookback follow the Metric window selector; streams are included in throughput and latency excludes aborted requests.",
  "schemaVersion": 41,
  "version": 5,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "sporades",
    "api"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_count_total{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,http_route=~`${route:regex}`}[${metric_window}]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 request latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,http_route=~`${route:regex}`,sporades_http_outcome!=\"abort\"}[${metric_window}])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors and denials per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, sporades_http_outcome) (rate(http_server_request_count_total{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,http_route=~`${route:regex}`,sporades_http_outcome=~\"error|failure|abort\"}[${metric_window}]))",
          "legendFormat": "{{service_name}} {{sporades_http_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests in flight",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (http_server_active_requests{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,http_route=~`${route:regex}`})",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 by declared route",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=~`${service:regex}`,deployment_environment_name=~`${environment:regex}`,http_route=~`${route:regex}`,sporades_http_outcome!=\"abort\"}[${metric_window}])))",
          "legendFormat": "{{service_name}} {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Capsule",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "query": "label_values(http_server_request_count_total, service_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "query": "label_values(http_server_request_count_total, deployment_environment_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "query": "label_values(http_server_request_count_total, http_route)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "metric_window",
        "label": "Metric window",
        "type": "custom",
        "query": "2m,12m",
        "options": [
          {
            "selected": false,
            "text": "2m",
            "value": "2m"
          },
          {
            "selected": true,
            "text": "12m",
            "value": "12m"
          }
        ],
        "current": {
          "selected": true,
          "text": "12m",
          "value": "12m"
        },
        "multi": false,
        "includeAll": false,
        "description": "12m supports metric exports up to 300s; use 2m only with exports at most 30s apart. Longer windows smooth rates and retain older delay peaks."
      }
    ]
  }
}
