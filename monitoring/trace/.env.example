# Copy is optional: node setup.mjs creates .env and only missing owned credentials.
# Fill external certificate paths only when TRACE_TLS_MODE=tls.
TRACE_TLS_MODE=tls
TRACE_BIND=127.0.0.1
TRACE_PORT=8443
TRACE_RETENTION=72h
METRIC_RETENTION=14d
METRIC_DISK_CAP=8GB
GRAFANA_ROOT_URL=https://monitor.example:8443/grafana/
# TRACE_CERT_FILE=/certs/fullchain.pem
# TRACE_KEY_FILE=/certs/privkey.pem
# TRACE_INGEST_TOKEN is generated by setup.mjs when absent.
TRACE_UI_USER=operator
# TRACE_UI_PASSWORD is generated by setup.mjs when absent.
# GRAFANA_ADMIN_PASSWORD is generated by setup.mjs when absent.

# Exact Host inventory authority: independent random token per stable Host ID.
# Fill with real tokens before connecting Hosts; setup never rotates this map.
# TRACE_INVENTORY_HOSTS='{"host-one":"<independent-random-Host-token>"}'
