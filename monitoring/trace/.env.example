# Copy is optional: node setup.mjs creates .env and only missing owned credentials.
# Fill external certificate paths only when TRACE_TLS_MODE=tls.
TRACE_TLS_MODE=tls
TRACE_BIND=127.0.0.1
TRACE_PORT=8443
TRACE_RETENTION=168h
TRACE_CERT_FILE=/certs/fullchain.pem
TRACE_KEY_FILE=/certs/privkey.pem
TRACE_INGEST_TOKEN=REPLACE_WITH_GENERATED_SECRET
TRACE_UI_USER=operator
TRACE_UI_PASSWORD=REPLACE_WITH_GENERATED_SECRET
