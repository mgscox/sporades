{
  "uid": "sporades-caddy",
  "title": "Sporades Caddy",
  "description": "Caddy edge/proxy metrics from private Prometheus scraping.",
  "schemaVersion": 41,
  "version": 3,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "sporades",
    "host"
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "query": "label_values(up{telemetry_source=~\"node|caddy\"}, sporades_host)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/grafana/d/sporades-fleet",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Capsule API",
      "type": "link",
      "url": "/grafana/d/sporades-api",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Capsule resources",
      "type": "link",
      "url": "/grafana/d/sporades-resources",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Host pressure",
      "type": "link",
      "url": "/grafana/d/sporades-hosts",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Caddy",
      "type": "link",
      "url": "/grafana/d/sporades-caddy",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Monitoring pipeline",
      "type": "link",
      "url": "/grafana/d/sporades-pipeline",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Caddy scrape health",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\"}",
          "legendFormat": "{{sporades_host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "1 = source scraped; 0 = scrape failed; no data = unavailable. Independent from application readiness.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Edge requests by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sporades_host,code) (rate(caddy_http_request_duration_seconds_count{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\",handler=\"subroute\"}[$__rate_interval]))",
          "legendFormat": "{{sporades_host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "Counts one top-level Caddyfile subroute observation per request. Other handlers and the private metrics listener are excluded.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Edge latency p50 / p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (sporades_host,le) (rate(caddy_http_request_duration_seconds_bucket{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\",handler=\"subroute\"}[$__rate_interval])))",
          "legendFormat": "{{sporades_host}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (sporades_host,le) (rate(caddy_http_request_duration_seconds_bucket{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\",handler=\"subroute\"}[$__rate_interval])))",
          "legendFormat": "{{sporades_host}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (sporades_host,le) (rate(caddy_http_request_duration_seconds_bucket{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\",handler=\"subroute\"}[$__rate_interval])))",
          "legendFormat": "{{sporades_host}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "Edge proxy duration includes upstream time; do not combine with Capsule latency histograms. Empty traffic yields no quantile.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Edge failures",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sporades_host) (rate(caddy_http_request_duration_seconds_count{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\",handler=\"subroute\",code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{sporades_host}} 5xx"
        },
        {
          "refId": "B",
          "expr": "sum by (sporades_host) (rate(caddy_http_request_errors_total{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\",handler=\"subroute\"}[$__rate_interval]))",
          "legendFormat": "{{sporades_host}} handler errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "Separate HTTP 5xx outcomes and middleware errors; they may overlap and are not additive.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Edge in-flight requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sporades_host) (caddy_http_requests_in_flight{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\",handler=\"subroute\"})",
          "legendFormat": "{{sporades_host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "Top-level Caddyfile subroute gauge; other handler observations and private metrics listener excluded.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Upstream health",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "caddy_reverse_proxy_upstreams_healthy{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\"}",
          "legendFormat": "{{sporades_host}} {{upstream}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "Caddy health state where exported/configured, not an independent application probe.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Caddy process RSS",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\"}",
          "legendFormat": "{{sporades_host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "Caddy process only, distinct from Capsule runtime memory.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Caddy CPU cores used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sporades-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{sporades_host=~`${host:regex}`,telemetry_source=\"caddy\"}[$__rate_interval])",
          "legendFormat": "{{sporades_host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unavailable / unsupported"
        }
      },
      "description": "1.0 is one logical CPU consumed by Caddy, not 100% of the whole Host.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Acknowledged lifecycle / deployment",
        "enable": true,
        "iconColor": "#5794F2",
        "datasource": {
          "type": "prometheus",
          "uid": "sporades-prometheus"
        },
        "expr": "(max by(host,service_name,state)(sporades_capsule_lifecycle_changed_seconds{host=~`${host:regex}`}) <= time()) and (max by(host,service_name,state)(sporades_capsule_lifecycle_changed_seconds{host=~`${host:regex}`}) > time() - 120)",
        "useValueForTime": true,
        "titleFormat": "{{service_name}}: {{state}}",
        "textFormat": "Host {{host}} acknowledged lifecycle/deployment change. Timestamp comes from inventory changedAt; not a Docker event or restart counter.",
        "tagKeys": "host,state",
        "step": "30s"
      }
    ]
  }
}
