{
  "name": "sporades",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "sporades": "./bin/sporades.js"
  },
  "exports": {
    "./server": {
      "types": "./src/types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/types/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node ./scripts/build-bin.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "npm run build && node ./scripts/check-generated-bin.mjs",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.25.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
