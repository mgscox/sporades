{
  "name": "sporades",
  "version": "0.9.13",
  "description": "CLI-first platform for building, running, and hosting full-stack Sporades Capsules.",
  "homepage": "https://mgscox.github.io/sporades/",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sporades": "./bin/sporades.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/types/",
    "CHANGES.md",
    "Dockerfile.base",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./src/types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server/stripe": {
      "types": "./src/types/stripe.d.ts",
      "default": "./dist/stripe-payment-integration.js"
    },
    "./server/team-billing-import": {
      "types": "./src/types/team-billing-import.d.ts",
      "default": "./dist/team-billing-import.js"
    },
    "./client": {
      "types": "./src/types/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/write-cli-version.mjs && tsc --project tsconfig.json && tsc --project tsconfig.runtime.json && node ./scripts/build-bin.mjs && node ./scripts/write-generated-source-manifest.mjs",
    "docs:build": "node ./scripts/build-docs.mjs",
    "docs:check": "npm run test:docs && npm run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc",
    "package": "node ./scripts/package.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.runtime.json",
    "pretest": "npm run build && node ./scripts/check-generated-bin.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:access-key-release": "node ./scripts/verify-access-key-release.mjs",
    "test:docs": "node --test --test-concurrency=1 test/docs.test.js test/docs-llms.test.js",
    "test:real-vite-container": "SPORADES_REAL_VITE_CONTAINER=1 node --test --test-concurrency=1 test/real-vite-container.test.js",
    "test:real-clamav-container": "SPORADES_REAL_CLAMAV_DOCKER=1 node --test --test-concurrency=1 test/clamav-docker.acceptance.test.js",
    "test:real-clamav-dev": "SPORADES_REAL_CLAMAV_DEV=1 node --test --test-concurrency=1 test/clamav-dev.acceptance.test.js",
    "prototype:require-auth-interface": "node ./.scratch/scoped-access-keys/prototypes/require-auth-interface/cli.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "dependencies": {
    "@lezer/python": "1.1.19",
    "acorn": "8.17.0",
    "esbuild": "0.25.12",
    "jpeg-js": "0.4.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pngjs": "7.0.0",
    "stripe": "^22.5.0",
    "unbash": "4.0.11",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.39",
    "happy-dom": "^20.10.6",
    "inferno": "^9.1.0",
    "inferno-create-element": "^9.1.0",
    "lit": "^3.3.3",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.12",
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "inferno@9.1.0": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "vitepress": {
      "vite": "$vite"
    }
  }
}
