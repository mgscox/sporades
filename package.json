{
  "name": "sporades",
  "version": "0.5.0",
  "description": "CLI-first platform for building, running, and hosting full-stack Sporades Capsules.",
  "homepage": "https://mgscox.github.io/sporades/",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sporades": "./bin/sporades.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/types/",
    "CHANGES.md",
    "Dockerfile.base",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./src/types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/types/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/write-cli-version.mjs && tsc --project tsconfig.json && node ./scripts/build-bin.mjs",
    "docs:build": "node ./scripts/build-docs.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc",
    "package": "node ./scripts/package.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "npm run build && node ./scripts/check-generated-bin.mjs",
    "test": "node --test --test-concurrency=1",
    "test:real-vite-container": "SPORADES_REAL_VITE_CONTAINER=1 node --test --test-concurrency=1 test/real-vite-container.test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.39",
    "happy-dom": "^20.10.6",
    "inferno": "^9.1.0",
    "inferno-create-element": "^9.1.0",
    "lit": "^3.3.3",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.4",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.12",
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
