{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Sporades SDK API",
  "entryPoints": [
    "src/types/server.d.ts",
    "src/types/client.d.ts",
    "src/types/stripe.d.ts"
  ],
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.typedoc.json",
  "out": "docs/api",
  "readme": "none",
  "cleanOutputDir": true,
  "hideGenerator": true,
  "gitRevision": "main",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/mgscox/sporades/blob/{gitRevision}/src/types/{path}#L{line}"
}
