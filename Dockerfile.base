FROM node:22.14-alpine

LABEL org.opencontainers.image.title="Sporades Base Image"
LABEL org.opencontainers.image.description="Thin Node 22 Base image for Sporades Container sessions and Hosted Capsules"
LABEL org.opencontainers.image.version="0.2.0-node22-alpine"
LABEL org.opencontainers.image.source="https://github.com/sporades/sporades"
LABEL com.sporades.base-image.name="sporades-base"
LABEL com.sporades.base-image.version="0.2.0-node22-alpine"
LABEL com.sporades.base-image.node="22"

RUN apk add --no-cache openssh-server fail2ban clamav clamav-daemon \
  && addgroup -g 10001 -S sporades \
  && adduser -u 10001 -S sporades -G sporades -s /bin/sh \
  && mkdir -p /app /app/data /app/data/clamav /run/sshd \
  && printf '%s\n' \
    'Foreground yes' \
    'DatabaseDirectory /app/data/clamav' \
    'LocalSocket /tmp/sporades-clamd.sock' \
    'LocalSocketMode 0600' \
    'FixStaleSocket yes' \
    'StreamMaxLength 10M' \
    'MaxFileSize 10M' \
    'MaxScanSize 10M' \
    'MaxRecursion 4' \
    'MaxFiles 100' \
    'MaxScanTime 10000' \
    'MaxThreads 4' \
    'MaxQueue 10' \
    > /etc/clamav/clamd.conf \
  && printf '%s\n' \
    'DatabaseDirectory /app/data/clamav' \
    'DatabaseMirror database.clamav.net' \
    'Checks 24' \
    'Foreground yes' \
    'NotifyClamd /etc/clamav/clamd.conf' \
    > /etc/clamav/freshclam.conf \
  && ssh-keygen -A \
  && printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    'if [ -n "${SPORADES_SSH_AUTHORIZED_KEYS_PATH:-}" ] && [ -s "${SPORADES_SSH_AUTHORIZED_KEYS_PATH}" ]; then' \
    '  target="${SPORADES_SSH_AUTHORIZED_KEYS_TARGET:-/app/data/ssh/authorized_keys}"' \
    '  ssh_dir="$(dirname "$target")"' \
    '  mkdir -p "$ssh_dir"' \
    '  cp "${SPORADES_SSH_AUTHORIZED_KEYS_PATH}" "$target"' \
    '  if [ ! -s "$ssh_dir/ssh_host_ed25519_key" ]; then' \
    '    ssh-keygen -t ed25519 -f "$ssh_dir/ssh_host_ed25519_key" -N "" >/dev/null' \
    '  fi' \
    '  chmod 700 "$ssh_dir"' \
    '  chmod 600 "$target"' \
    '  chmod 600 "$ssh_dir/ssh_host_ed25519_key"' \
    '  /usr/sbin/sshd -f /etc/ssh/sshd_config -o PasswordAuthentication=no -o PermitRootLogin=no -o AllowUsers=sporades -o AuthorizedKeysFile="$target" -o HostKey="$ssh_dir/ssh_host_ed25519_key" -o PidFile=/tmp/sporades-sshd.pid' \
    'fi' \
    'exec node /app/server.mjs' \
    > /usr/local/bin/sporades-start \
  && chmod 0755 /usr/local/bin/sporades-start \
  && chown -R 10001:10001 /app

WORKDIR /app
USER 10001:10001

CMD ["node", "/app/server.mjs"]
